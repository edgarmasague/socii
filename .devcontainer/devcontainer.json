{
    "name": "Socii",
    "image": "mcr.microsoft.com/devcontainers/php:1-8.4-bookworm",

    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client"
            ]
        }
    },

    "forwardPorts": [8000, 5173],

    "postCreateCommand": "composer install && npm install"
}